# ---------------------------------------------------------------------------
# Local run output
# ---------------------------------------------------------------------------
/runs/
/work/
*.tmp
*.bak
*.orig
*.rej

# QEMU images and local VM state (the guest image is supplied separately)
*.img
*.qcow2
*.iso
*.vmdk

# Videos and screenshots are deliberately not tracked.  They are generated
# at run time by the harness and are not part of the code package.
*.mp4
*.mkv
*.mov
*.avi
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# In-repo kernel build output
kernel/target/

# Kernel binaries are GitHub Release assets, not repository content
/artifacts/*.bin
/release-assets/

# Experiment raw logs stay local; commit only plan/decision summaries
/experiments/**/run*/
/experiments/**/raw/

# Invalid E003 diagnostic sessions (screenshots, no first frame)
/evidence/perf/e003b*/
/evidence/perf/e003c*/
/evidence/perf/e003fix*/
/evidence/reports/perf-report-e003b.json
/evidence/reports/perf-report-e003c.json
/evidence/reports/perf-report-e003fix.json

/evidence/perf/e003d*/
/evidence/perf/e003e*/
/evidence/perf/e003f*/
/evidence/perf/e003g*/

/evidence/reports/perf-report-e003e.json

# Local experiments and publication caches
/experiments/
/DeepSeek_harness_*/
/.local/
*.elf
*.debug
*.zip
/evidence/perf/
/evidence/sessions/


# Local duplicate progress packages and full baseline sessions
/submission/
/evidence/baseline/final1/
/evidence/baseline/x4final/
/tests/debug-*.ps1


# Optional generated diagnostic helper and symbol tables
/guest/mono-clock
/artifacts/*.symtab
