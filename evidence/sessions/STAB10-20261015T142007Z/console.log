> #!/bin/sh
> # Guest-side: hold the rendered page for 10 minutes and sample the session.
> #
> # Why a settle loop instead of one sleep: the acceptance criterion is that the
> # compositor does not exit for at least 10 minutes, and a single long sleep
> # cannot distinguish 'still running' from 'already dead'.  Each sample is
> # printed so a failure is localised to a time window, and the harness takes
> # screendumps at both ends of the window.
> set -u
> A=/run/x11/auth
> export DISPLAY=:0 XAUTHORITY=$A
> echo "S1 start=$(date +%s)"
> t=0
> while [ "$t" -lt 600 ]; do
>   sleep 60
>   t=$((t+60))
>   xo=$(ps w | grep -c '[X]org')
>   jm=$(ps w | grep -c '[j]wm')
>   ch=$(ps w | grep -c '[c]hromium')
>   rd=$(ps w | grep -c '[-]-type=renderer')
>   gp=$(ps w | grep -c '[-]-type=gpu')
>   echo "S t=$t xorg=$xo jwm=$jm chrome=$ch rend=$rd gpu=$gp"
> done
> echo "S2 proc=$([ -S /tmp/.X11-unix/X0 ] && echo sock-ok || echo SOCK-GONE)"
> echo "S3 xrandr=$(xrandr --current 2>&1 | head -1)"
> echo "S4 rs=$(xprop -root _NET_SUPPORTING_WM_CHECK 2>&1 | head -1)"
> echo "S5 cl=$(xprop -root _NET_CLIENT_LIST 2>&1 | head -1)"
> echo "S6 log=$(wc -c < /tmp/w.log 2>/dev/null)"
> echo S7
> 
> XK_H_EOF_2cb03bb9
