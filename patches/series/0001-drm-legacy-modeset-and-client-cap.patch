+            fb_id: f.fb_id,
+            width: f.width,
+            height: f.height,
+            pixel_format: DRM_FORMAT_XRGB8888,
+            flags: 0,
+            handles: [f.handle, 0, 0, 0],
+            pitches: [f.pitch, 0, 0, 0],
+            offsets: [0; 4],
+            abi_pad: 0,
+            modifier: [0; 4],
+        };
+        <DrmModeFbCmd2 as DrmIoctl>::handle(dev, file, &mut modern)?;
+        f.fb_id = modern.fb_id;
+        Ok(0)
+    }
