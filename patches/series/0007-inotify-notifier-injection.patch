@@ -73,6 +73,21 @@ pub fn sys_unlinkat(dirfd: i32, path: UserConstPtr<c_char>, flags: usize) -> KRe
         } else {
             filename.unlink_at(fs.root(), fs.pwd(), &cred)?;
         }
+        // Report the removal after it succeeded, so a watcher never sees IN_DELETE
+        // for a call that failed.  Same base rule as `sys_openat`: the pwd for a
+        // relative path, "/" for an absolute one, because `notify_change_at` takes
+        // the parent out of an absolute path itself.
+        let pwd = fs.pwd().display_path();
+        let base = if path.starts_with('/') {
+            "/"
+        } else {
+            pwd.as_deref().unwrap_or("/")
+        };
+        crate::notify::notify_change_at(
+            base.as_bytes(),
+            path.as_bytes(),
+            crate::notify::IN_DELETE,
+        );
         Ok(0)
     })
 }
