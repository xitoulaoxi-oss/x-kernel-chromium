+
+#[def_test]
+fn test_keepalive_defaults_match_linux() {
+    // net.ipv4.tcp_keepalive_{time,intvl,probes} on a stock Linux kernel.
+    assert_eq!(TCP_KEEPIDLE_DEFAULT_SECS, 7200);
+    assert_eq!(TCP_KEEPINTVL_DEFAULT_SECS, 75);
+    assert_eq!(TCP_KEEPCNT_DEFAULT, 9);
+}
+
+#[def_test]
+fn test_keepalive_rejects_zero() {
+    // Zero is what turns smoltcp's keep-alive deadline into "always due": the
+    // poller then re-arms on every iteration instead of waiting.
+    assert!(!keepalive_value_in_range(0, TCP_KEEPALIVE_MAX_SECS));
+    assert!(!keepalive_value_in_range(0, TCP_KEEPALIVE_MAX_PROBES));
+}
+
+#[def_test]
+fn test_keepalive_accepts_one_and_the_maximum() {
+    assert!(keepalive_value_in_range(1, TCP_KEEPALIVE_MAX_SECS));
+    assert!(keepalive_value_in_range(
+        TCP_KEEPALIVE_MAX_SECS,
+        TCP_KEEPALIVE_MAX_SECS
+    ));
+    assert!(keepalive_value_in_range(127, TCP_KEEPALIVE_MAX_PROBES));
+}
+
+#[def_test]
+fn test_keepalive_rejects_above_maximum() {
+    assert!(!keepalive_value_in_range(
+        TCP_KEEPALIVE_MAX_SECS + 1,
+        TCP_KEEPALIVE_MAX_SECS
+    ));
+    assert!(!keepalive_value_in_range(
+        TCP_KEEPALIVE_MAX_PROBES + 1,
+        TCP_KEEPALIVE_MAX_PROBES
+    ));
 }
 
 #[def_test]
