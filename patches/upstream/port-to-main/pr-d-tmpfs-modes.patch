+    /// Applies permission bits to a path.
+    ///
+    /// Only for mount points this module creates itself during early boot, where
+    /// the kernel is the owner and the mode has to match what user space expects
+    /// from Linux. `mkdir_at` creates directories with 0o755, which is right for
+    /// a private directory and wrong for the world-writable ones.
+    fn set_mode_path(&self, path: &str, mode: u16) -> kvfs::VfsResult<()> {
+        let cred = kcred::initial_cred();
+        let target = self.lookup(path)?;
+        target.chmod(NodePermission::from_bits_truncate(mode), &cred)
