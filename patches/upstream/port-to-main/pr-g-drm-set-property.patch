+/// `struct drm_mode_connector_set_property`, the legacy connector-only setter.
+///
+/// `value` comes first and the structure is 16 bytes with no trailing padding, so
+/// `DRM_IOCTL_MODE_SETPROPERTY` carries size 0x10.
+#[repr(C)]
+#[derive(Debug, Default, Clone, Copy, AnyBitPattern, UserRead, UserWrite)]
+pub(crate) struct DrmModeConnectorSetProperty {
+    pub value: u64,
+    pub prop_id: u32,
+    pub connector_id: u32,
+}
+
+/// `struct drm_mode_obj_set_property`, the object-typed setter.
+///
+/// `value` at 0, `prop_id` at 8, `obj_id` at 12, `obj_type` at 16, padded to 24
+/// because the structure aligns to 8.  The asserts below keep that true: the size
+/// is part of the command word, so a layout change that goes unnoticed would leave
+/// the handler registered under a number no client sends.
+#[repr(C)]
+#[derive(Debug, Default, Clone, Copy, AnyBitPattern, UserRead, UserWrite)]
+pub(crate) struct DrmModeObjSetProperty {
+    pub value: u64,
+    pub prop_id: u32,
+    pub obj_id: u32,
+    pub obj_type: u32,
+}
+
+const _: () = assert!(core::mem::size_of::<DrmModeConnectorSetProperty>() == 16);
+const _: () = assert!(core::mem::size_of::<DrmModeObjSetProperty>() == 24);
+
