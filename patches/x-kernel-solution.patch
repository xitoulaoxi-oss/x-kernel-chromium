+
+    /// Total virtual size of this process's mappings, in bytes.
+    ///
+    /// The sum runs over the same VMA list `/proc/<pid>/maps` renders, so
+    /// `VmSize:` in `/proc/<pid>/status` and field 23 of `/proc/<pid>/stat`
+    /// cannot end up describing different address spaces. `None` means the
+    /// address space is already detached -- a process that is gone has nothing
+    /// to size, and 0 would be indistinguishable from an empty one.
+    pub fn virtual_memory_size(&self) -> Option<u64> {
+        let aspace = self.address_space().ok()?;
+        let aspace = aspace.lock();
+        Some(
+            aspace
+                .vmas()
+                .map(|vma| vma.end().as_usize().saturating_sub(vma.start().as_usize()) as u64)
+                .sum(),
+        )
     }
 
