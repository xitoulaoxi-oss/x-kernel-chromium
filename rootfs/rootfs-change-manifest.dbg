# rootfs change manifest -- debugfs form
#
# Generated by host/make_rootfs_manifest.py.  Every write this project makes to
# the guest filesystem is listed here, with the command that reproduces it.
#
# Apply against a WORKING COPY of the delivered image, never the original:
#   python host/rootfs_audit.py workcopy
#   debugfs -w -f <this-file> <working-copy.img>
#
# Scope: three new files (the committee's test pages, absent from the image) and
# one rewritten configuration file.  No binary, no /init, no /etc/inittab.


# Run from the staging directory, which holds every file:
#   cd rootfs/debugfs-stage
#   debugfs -w -f ../rootfs-change-manifest.dbg <working-copy.img>

# --- files written into the guest ---
# /usr/share/kiosk/official/index.html  <-  index.html  [NEW FILE (absent from image)]
write index.html /usr/share/kiosk/official/index.html
# /usr/share/kiosk/official/interaction.html  <-  interaction.html  [NEW FILE (absent from image)]
write interaction.html /usr/share/kiosk/official/interaction.html
# /usr/share/kiosk/official/layout.html  <-  layout.html  [NEW FILE (absent from image)]
write layout.html /usr/share/kiosk/official/layout.html
# /etc/kiosk/url  <-  kiosk-url  [REWRITTEN (was the 3,024 B placeholder path)]
write kiosk-url /etc/kiosk/url

